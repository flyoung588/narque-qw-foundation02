{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "source_state_hash",
    "status",
    "values",
    "provenance",
    "new_physics_run"
  ],
  "properties": {
    "schema": {
      "const": "QW_OBSERVATION_ENVELOPE_01"
    },
    "source_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_physics_run": {
      "const": false
    },
    "new_scientific_executions": {
      "const": 0
    },
    "source_execution_kind": {
      "enum": [
        "HISTORICAL_REPLAY",
        "NEW_SCIENTIFIC_EXECUTION",
        "SYNTHETIC",
        "NEW_STRUCTURE_NOT_CALCULATED",
        "UNKNOWN",
        "UNVERIFIED"
      ]
    },
    "source_execution_status": {
      "type": "string"
    },
    "observables": {
      "type": "object"
    },
    "values": {
      "type": "object"
    },
    "status": {
      "enum": [
        "HISTORICAL_OBSERVATION_READ",
        "SOFTWARE_FIXTURE_ONLY",
        "STRUCTURE_ONLY_NOT_CALCULATED",
        "SCIENTIFIC_OBSERVATION_READ",
        "UNVERIFIED",
        "MODEL_STATE_READ_NOT_CALCULATED"
      ]
    }
  }
}
